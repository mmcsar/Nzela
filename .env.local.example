# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Requis pour : admin (liste entreprises/courtiers), notifications, associations. Dashboard Supabase > Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Windows local : si la connexion est rejetée (erreur certificat SSL / Supabase),
# npm run dev active un contournement TLS automatique. Forcer : NZELA_DEV_RELAX_TLS=1
# Désactiver : NZELA_DEV_RELAX_TLS=0
# Diagnostic : node scripts/check-supabase-tls.cjs
# Numéro affiché sur Contact, Footer et paramètres admin
NEXT_PUBLIC_SUPPORT_PHONE=+243 995 547 081

# PWA
NEXT_PUBLIC_APP_NAME=Nzela
NEXT_PUBLIC_APP_DESCRIPTION=Plateforme de logistique pour le Haut-Katanga et Lualaba

# Abonnement : par defaut suspendu (tout le monde peut publier). Mettre true pour exiger un abonnement apres la periode gratuite.
# SUBSCRIPTION_GATE_ENABLED=true

# Flutterwave (Mobile Money Payments)
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxx-X
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_hash_here

# Web Push (VAPID Keys) - Generer avec: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:info@nzelaa.com




